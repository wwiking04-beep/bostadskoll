{
  "cleanUrls": true,
  "trailingSlash": true,
  "crons": [ { "path": "/api/paminnelser/", "schedule": "0 6 * * *" } ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/(stil.css|app.js|ikon.svg)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] }
  ]
}
